    "app/poanalytics"
  ],
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "varun": {
              "password": "1234",
              "roles": [
                "Display"
              ],
              "attr": {
                "Spiderman": "My Bank of London"
              }
            },
            "yamini": {
              "password": "4321",
              "roles": [
                "Edit"
              ]
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      },
      "[production]": {
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
